{
  "schemaVersion": 1,
  "id": "dd.starlink",
  "name": "Starlink",
  "version": "0.1.0",
  "author": "dd",
  "license": "MIT",
  "description": "Starlink-Verbindung in der Bar: Verzögerung, Zustand und Grund eines Unterbruchs.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Starlink",
    "description": "Verzögerung in der Bar, Panel mit Zustand und Grund des Unterbruchs.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Abfrage alle (Sekunden)",
        "min": 2,
        "max": 300,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
