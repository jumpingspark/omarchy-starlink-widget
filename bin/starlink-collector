#!/usr/bin/env bash
# Sammler: fragt die Starlink-Schüssel laufend ab, erkennt Unterbrüche und
# schreibt den Stand nach ~/.local/state/starlink/status.json.
# Das Bar-Widget startet ihn und hält ihn am Leben; endet das Widget (Shell
# neu gestartet, Plugin entfernt), schliesst sich seine Eingabe und er beendet
# sich selbst. Eine Sperre sorgt dafür, dass nur ein Sammler läuft.
# Beim ersten Start richtet er sich seine Python-Umgebung selbst ein
# (~/.local/share/starlink-widget/venv, Paket starlink-grpc-core).
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/starlink"
VENV="${XDG_DATA_HOME:-$HOME/.local/share}/starlink-widget/venv"
PY="$VENV/bin/python"
mkdir -p "$STATE_DIR"

# Nur ein Sammler zur Zeit (Bar auf zwei Bildschirmen, Neustart der Shell).
exec 9>"$STATE_DIR/collector.lock"
flock -n 9 || exit 0

write_status() {
  # $1: Meldung. Schreibt einen Stand ohne Schüssel, damit das Panel etwas sagen kann.
  local tmp="$STATE_DIR/status.json.tmp"
  printf '{"ts": %d, "ok": false, "setup": true, "error": %s, "outages": [], "history": [], "current_outage": null}\n' \
    "$(date +%s)" "$(printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')" >"$tmp"
  mv -f "$tmp" "$STATE_DIR/status.json"
}

if ! "$PY" -c 'import starlink_grpc' >/dev/null 2>&1; then
  write_status "Python-Umgebung wird eingerichtet"
  {
    echo "== $(date -Is) richte $VENV ein"
    rm -rf "$VENV"
    python3 -m venv "$VENV"
    "$PY" -m pip install --quiet --disable-pip-version-check starlink-grpc-core
  } >>"$STATE_DIR/setup.log" 2>&1 || {
    write_status "Einrichtung fehlgeschlagen, siehe $STATE_DIR/setup.log"
    exit 1
  }
fi

exec "$PY" -u - "$STATE_DIR" <<'PYEOF'
import json
import os
import sys
import threading
import time

state_dir = sys.argv[1]
status_path = os.path.join(state_dir, "status.json")
outages_path = os.path.join(state_dir, "outages.jsonl")

INTERVAL = 2            # Sekunden zwischen zwei Abfragen
HISTORY_S = 15 * 60     # Verlauf, den status.json trägt
MAX_OUTAGES = 200       # Unterbrüche, die status.json trägt

import starlink_grpc


# Das Widget hält unsere Eingabe offen. Schliesst sie sich, ist das Widget weg,
# und wir gehen mit.
def watch_stdin():
    try:
        sys.stdin.read()
    except Exception:
        pass
    os._exit(0)


threading.Thread(target=watch_stdin, daemon=True).start()


def boot_time():
    with open("/proc/uptime") as f:
        up = float(f.read().split()[0])
    return int(time.time() - up)


def write_atomic(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def load_outages(since):
    out = []
    try:
        with open(outages_path) as f:
            for line in f:
                try:
                    o = json.loads(line)
                except ValueError:
                    continue
                if o.get("start", 0) >= since:
                    out.append(o)
    except FileNotFoundError:
        pass
    return out[-MAX_OUTAGES:]


boot = boot_time()
outages = load_outages(boot)
history = []            # [ts, latenz_ms, verlust_anteil]
current = None          # laufender Unterbruch {start, cause}
last_ok = None          # Zeitpunkt der letzten Antwort der Schüssel; None: noch nie
ctx = None

while True:
    ts = int(time.time())
    status = None
    error = ""
    try:
        if ctx is None:
            ctx = starlink_grpc.ChannelContext()
        status, obstruction, alerts = starlink_grpc.status_data(ctx)
    except Exception as e:
        error = str(e).splitlines()[0] if str(e) else e.__class__.__name__
        try:
            if ctx is not None:
                ctx.close()
        except Exception:
            pass
        ctx = None

    if status is not None:
        last_ok = ts
        state = str(status.get("state", ""))
        connected = state == "CONNECTED"
        latency = status.get("pop_ping_latency_ms")
        drop = status.get("pop_ping_drop_rate")
        history.append([ts, latency, drop])
        # Unterbruch beginnt oder endet
        if not connected and current is None:
            current = {"start": ts, "cause": state}
        elif not connected and current is not None and current["cause"] != state:
            current["cause"] = state
        elif connected and current is not None:
            done = {"start": current["start"], "end": ts,
                    "duration_s": ts - current["start"], "cause": current["cause"]}
            outages.append(done)
            outages = outages[-MAX_OUTAGES:]
            with open(outages_path, "a") as f:
                f.write(json.dumps(done) + "\n")
            current = None
    else:
        # Schüssel weg: laufenden Unterbruch offen lassen, Verlauf nicht füllen
        pass

    cutoff = ts - HISTORY_S
    history = [h for h in history if h[0] >= cutoff]

    doc = {
        "ts": ts,
        "boot": boot,
        "ok": status is not None,
        "last_ok": last_ok,
        "error": error,
        "interval_s": INTERVAL,
        "current_outage": current,
        "outages": outages,
        "history": history,
    }
    if status is not None:
        active_alerts = [name for name, on in alerts.items() if on]
        doc.update({
            "state": status.get("state", ""),
            "latency_ms": status.get("pop_ping_latency_ms"),
            "drop": status.get("pop_ping_drop_rate"),
            "down_bps": status.get("downlink_throughput_bps"),
            "up_bps": status.get("uplink_throughput_bps"),
            "uptime_s": status.get("uptime"),
            "obstructed": status.get("currently_obstructed"),
            "fraction_obstructed": status.get("fraction_obstructed"),
            "alerts": active_alerts,
        })
    write_atomic(status_path, doc)
    time.sleep(INTERVAL if status is not None else 10)
PYEOF
